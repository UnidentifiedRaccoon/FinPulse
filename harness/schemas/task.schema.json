{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinPulse Agent Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "model",
    "goal",
    "writeSet",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "blocked",
        "review",
        "done"
      ]
    },
    "owner": {
      "type": "string"
    },
    "model": {
      "const": "gpt-5.5/xhigh"
    },
    "goal": {
      "type": "string"
    },
    "writeSet": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string"
    }
  }
}