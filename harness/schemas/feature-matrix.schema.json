{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinPulse Feature Matrix",
  "type": "object",
  "required": [
    "version",
    "productPhase",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "productPhase": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "acceptance",
          "evalStatus"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "active",
              "blocked",
              "review",
              "done",
              "deferred"
            ]
          },
          "owner": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evalStatus": {
            "enum": [
              "not_applicable_yet",
              "deferred",
              "planned",
              "implemented"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}