{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finpulse.local/schemas/content.schema.json",
  "title": "FinPulse Program Manifest",
  "$ref": "#/$defs/programManifest",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "plainText": {
      "type": "string",
      "description": "Plain text only. Do not use Markdown markers, links, inline code, underline tags, headings, or lists.",
      "not": {
        "anyOf": [
          { "pattern": "\\*\\*|\\*[^*\\n]+\\*|__|`|\\[[^\\]\\n]+\\]\\([^)]+\\)|</?[uU]>" },
          { "pattern": "(^|\\n)\\s{0,3}#{1,6}\\s" },
          { "pattern": "(^|\\n)\\s*(?:[-*+]|[0-9]+[.)])\\s+" }
        ]
      }
    },
    "plainTextRequired": {
      "allOf": [{ "$ref": "#/$defs/plainText" }],
      "minLength": 1
    },
    "markdownText": {
      "type": "string",
      "description": "Approved Markdown subset: paragraphs, inline bold/italic, links, and <u>...</u>. No arbitrary HTML, Markdown headings, Markdown lists, or tables.",
      "allOf": [
        { "not": { "pattern": "</?(?![uU]\\b)[A-Za-z][^>]*>" } },
        { "not": { "pattern": "<[uU]\\s+[^>]*>" } },
        { "not": { "pattern": "(^|\\n)\\s{0,3}#{1,6}\\s" } },
        { "not": { "pattern": "(^|\\n)\\s*(?:[-*+]|[0-9]+[.)])\\s+" } }
      ]
    },
    "markdownTextRequired": {
      "allOf": [{ "$ref": "#/$defs/markdownText" }],
      "minLength": 1
    },
    "checkability": {
      "enum": ["objective", "subjective", "mixed"]
    },
    "customOption": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/plainTextRequired" },
        "placeholder": { "$ref": "#/$defs/plainTextRequired" }
      }
    },
    "cardStatistics": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/plainTextRequired" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "$ref": "#/$defs/plainTextRequired" },
              "label": { "$ref": "#/$defs/markdownTextRequired" }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/markdownTextRequired" }
        }
      }
    },
    "programManifest": {
      "type": "object",
      "required": ["schemaVersion", "id", "slug", "title", "levels"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "description": {
          "$ref": "#/$defs/plainText"
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/levelRef"
          }
        }
      }
    },
    "levelRef": {
      "type": "object",
      "required": ["id", "slug", "title", "order", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "description": {
          "$ref": "#/$defs/plainText"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/plainTextRequired"
        }
      }
    },
    "levelFile": {
      "type": "object",
      "required": ["schemaVersion", "id", "slug", "title", "order", "sections"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "description": {
          "$ref": "#/$defs/plainText"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/plainText"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sectionRef"
          }
        }
      }
    },
    "sectionRef": {
      "type": "object",
      "required": ["id", "slug", "title", "order", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "description": {
          "$ref": "#/$defs/plainText"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/plainTextRequired"
        }
      }
    },
    "sectionFile": {
      "type": "object",
      "required": ["schemaVersion", "id", "slug", "title", "order", "source", "lessons"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "description": {
          "$ref": "#/$defs/plainText"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        },
        "supplemental": {
          "$ref": "#/$defs/supplemental"
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["id", "slug", "title", "order", "cards"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "subtitle": {
          "$ref": "#/$defs/plainText"
        },
        "description": {
          "$ref": "#/$defs/plainText"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "learningGoal": {
          "$ref": "#/$defs/plainText"
        },
        "mainSkill": {
          "$ref": "#/$defs/plainText"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plainTextRequired"
          }
        },
        "sourceSection": {
          "$ref": "#/$defs/plainText"
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      }
    },
    "cardBase": {
      "type": "object",
      "required": ["id", "type", "order"],
      "properties": {
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "type": {
          "enum": [
            "theory",
            "video",
            "callout",
            "single_choice",
            "multi_select",
            "categorization",
            "reflection",
            "scenario",
            "artifact",
            "checklist",
            "summary"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "$ref": "#/$defs/plainText"
        },
        "sourceSection": {
          "$ref": "#/$defs/plainText"
        },
        "ctaLabel": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "thinkingType": {
          "$ref": "#/$defs/plainText"
        },
        "develops": {
          "$ref": "#/$defs/plainText"
        },
        "checkability": {
          "$ref": "#/$defs/checkability"
        },
        "statistics": {
          "$ref": "#/$defs/cardStatistics"
        }
      }
    },
    "choiceOption": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "label": {
          "$ref": "#/$defs/plainTextRequired"
        },
        "isCorrect": {
          "type": "boolean"
        },
        "feedback": {
          "$ref": "#/$defs/markdownText"
        }
      }
    },
    "card": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "theory" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "body": { "$ref": "#/$defs/markdownTextRequired" },
                "examples": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/plainTextRequired" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "title", "src"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "video" },
                "order": true,
                "title": { "$ref": "#/$defs/plainTextRequired" },
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "src": { "$ref": "#/$defs/plainTextRequired" },
                "provider": { "$ref": "#/$defs/plainText" },
                "transcript": { "$ref": "#/$defs/markdownText" },
                "timecodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["time", "label"],
                    "additionalProperties": false,
                    "properties": {
                      "time": { "$ref": "#/$defs/plainTextRequired" },
                      "label": { "$ref": "#/$defs/plainTextRequired" }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "callout" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "tone": { "enum": ["info", "warning", "success", "reflection"] },
                "body": { "$ref": "#/$defs/markdownTextRequired" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "question", "options"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "single_choice" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "question": { "$ref": "#/$defs/markdownTextRequired" },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "$ref": "#/$defs/choiceOption" }
                },
                "correctOptionId": { "$ref": "#/$defs/plainText" },
                "feedbackTitle": { "$ref": "#/$defs/plainText" },
                "feedback": { "$ref": "#/$defs/markdownText" },
                "retryFeedbackTitle": { "$ref": "#/$defs/plainText" },
                "retryFeedback": { "$ref": "#/$defs/markdownText" },
                "readOnly": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "question", "options"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "multi_select" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "question": { "$ref": "#/$defs/markdownTextRequired" },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "$ref": "#/$defs/choiceOption" }
                },
                "feedbackTitle": { "$ref": "#/$defs/plainText" },
                "feedback": { "$ref": "#/$defs/markdownText" },
                "retryFeedbackTitle": { "$ref": "#/$defs/plainText" },
                "retryFeedback": { "$ref": "#/$defs/markdownText" },
                "readOnly": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "question", "categories", "items"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "categorization" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "question": { "$ref": "#/$defs/markdownTextRequired" },
                "categories": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["id", "label"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "$ref": "#/$defs/plainTextRequired" },
                      "label": { "$ref": "#/$defs/plainTextRequired" }
                    }
                  }
                },
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "correctCategoryId"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "$ref": "#/$defs/plainTextRequired" },
                      "label": { "$ref": "#/$defs/plainTextRequired" },
                      "correctCategoryId": { "$ref": "#/$defs/plainTextRequired" },
                      "feedback": { "$ref": "#/$defs/markdownText" }
                    }
                  }
                },
                "feedbackTitle": { "$ref": "#/$defs/plainText" },
                "feedback": { "$ref": "#/$defs/markdownText" },
                "retryFeedbackTitle": { "$ref": "#/$defs/plainText" },
                "retryFeedback": { "$ref": "#/$defs/markdownText" },
                "readOnly": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "prompt"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "reflection" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "prompt": { "$ref": "#/$defs/markdownTextRequired" },
                "inputType": { "enum": ["text", "single_select", "multi_select", "table", "freeform"] },
                "options": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/plainTextRequired" }
                },
                "customOption": { "$ref": "#/$defs/customOption" },
                "saveKey": { "$ref": "#/$defs/plainText" },
                "guidance": { "$ref": "#/$defs/markdownText" },
                "readOnly": { "type": "boolean" }
              },
              "if": {
                "required": ["customOption"]
              },
              "then": {
                "required": ["inputType"],
                "properties": {
                  "inputType": { "const": "single_select" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "scenario" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "body": { "$ref": "#/$defs/markdownTextRequired" },
                "question": { "$ref": "#/$defs/markdownText" },
                "options": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/choiceOption" }
                },
                "correctOptionId": { "$ref": "#/$defs/plainText" },
                "feedbackTitle": { "$ref": "#/$defs/plainText" },
                "feedback": { "$ref": "#/$defs/markdownText" },
                "retryFeedbackTitle": { "$ref": "#/$defs/plainText" },
                "retryFeedback": { "$ref": "#/$defs/markdownText" },
                "readOnly": { "type": "boolean" }
              },
              "dependentRequired": {
                "correctOptionId": ["options"]
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "artifact" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "body": { "$ref": "#/$defs/markdownTextRequired" },
                "template": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/markdownTextRequired" }
                },
                "variants": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/plainTextRequired" }
                },
                "customOption": { "$ref": "#/$defs/customOption" },
                "readOnly": { "type": "boolean" }
              },
              "if": {
                "required": ["customOption"]
              },
              "then": {
                "required": ["variants"],
                "properties": {
                  "variants": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "items"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "checklist" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "body": { "$ref": "#/$defs/markdownText" },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/plainTextRequired" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "points"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "summary" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "ctaLabel": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "statistics": true,
                "body": { "$ref": "#/$defs/markdownText" },
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/markdownTextRequired" }
                },
                "nextStep": { "$ref": "#/$defs/markdownText" }
              }
            }
          ]
        }
      ]
    },
    "supplementalItem": {
      "type": "object",
      "required": ["id", "title", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/plainTextRequired" },
        "title": { "$ref": "#/$defs/plainTextRequired" },
        "sourceSection": { "$ref": "#/$defs/plainText" },
        "type": { "$ref": "#/$defs/plainText" },
        "summary": { "$ref": "#/$defs/plainTextRequired" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/plainTextRequired" }
        }
      }
    },
    "supplemental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "$ref": "#/$defs/plainText" },
        "sourceFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/plainTextRequired" }
        },
        "trainings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementalItem"
          }
        },
        "spacedRepetition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementalItem"
          }
        },
        "expansionScenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementalItem"
          }
        },
        "editorialRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/plainTextRequired" }
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "definition"],
            "additionalProperties": false,
            "properties": {
              "term": { "$ref": "#/$defs/plainTextRequired" },
              "definition": { "$ref": "#/$defs/plainTextRequired" }
            }
          }
        },
        "outcome": {
          "type": "array",
          "items": { "$ref": "#/$defs/plainTextRequired" }
        }
      }
    }
  }
}
