{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finpulse.local/schemas/content.schema.json",
  "title": "FinPulse Program Content",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "title",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "order",
        "lessons"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "order",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "level",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "heading"
            },
            "level": {
              "enum": [
                2,
                3
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "list"
            },
            "style": {
              "enum": [
                "bullet",
                "numbered"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "quote"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "callout"
            },
            "tone": {
              "enum": [
                "info",
                "warning",
                "success"
              ]
            },
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "src",
            "alt"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "image"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "src",
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "video"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "transcript": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}