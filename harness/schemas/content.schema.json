{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finpulse.local/schemas/content.schema.json",
  "title": "FinPulse Program Manifest",
  "$ref": "#/$defs/programManifest",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "checkability": {
      "enum": ["objective", "subjective", "mixed"]
    },
    "programManifest": {
      "type": "object",
      "required": ["schemaVersion", "id", "slug", "title", "modules"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/moduleRef"
          }
        }
      }
    },
    "moduleRef": {
      "type": "object",
      "required": ["id", "slug", "title", "order", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "moduleFile": {
      "type": "object",
      "required": ["schemaVersion", "id", "slug", "title", "order", "units"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unitRef"
          }
        }
      }
    },
    "unitRef": {
      "type": "object",
      "required": ["id", "slug", "title", "order", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unitFile": {
      "type": "object",
      "required": ["schemaVersion", "id", "slug", "title", "order", "source", "lessons"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        },
        "supplemental": {
          "$ref": "#/$defs/supplemental"
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["id", "slug", "title", "order", "cards"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "learningGoal": {
          "type": "string"
        },
        "mainSkill": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceSection": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      }
    },
    "cardBase": {
      "type": "object",
      "required": ["id", "type", "order"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "theory",
            "video",
            "callout",
            "single_choice",
            "reflection",
            "scenario",
            "artifact",
            "checklist",
            "summary"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "sourceSection": {
          "type": "string"
        },
        "thinkingType": {
          "type": "string"
        },
        "develops": {
          "type": "string"
        },
        "checkability": {
          "$ref": "#/$defs/checkability"
        }
      }
    },
    "choiceOption": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "isCorrect": {
          "type": "boolean"
        },
        "feedback": {
          "type": "string"
        }
      }
    },
    "card": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "theory" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "body": { "type": "string", "minLength": 1 },
                "examples": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "title", "src"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "video" },
                "order": true,
                "title": { "type": "string", "minLength": 1 },
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "src": { "type": "string", "minLength": 1 },
                "provider": { "type": "string" },
                "transcript": { "type": "string" },
                "timecodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["time", "label"],
                    "additionalProperties": false,
                    "properties": {
                      "time": { "type": "string", "minLength": 1 },
                      "label": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "callout" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "tone": { "enum": ["info", "warning", "success", "reflection"] },
                "body": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "question", "options"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "single_choice" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "question": { "type": "string", "minLength": 1 },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "$ref": "#/$defs/choiceOption" }
                },
                "correctOptionId": { "type": "string" },
                "feedback": { "type": "string" },
                "readOnly": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "prompt"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "reflection" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "prompt": { "type": "string", "minLength": 1 },
                "inputType": { "enum": ["text", "single_select", "multi_select", "table", "freeform"] },
                "options": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "saveKey": { "type": "string" },
                "guidance": { "type": "string" },
                "readOnly": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "scenario" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "body": { "type": "string", "minLength": 1 },
                "question": { "type": "string" },
                "options": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/choiceOption" }
                },
                "correctOptionId": { "type": "string" },
                "feedback": { "type": "string" },
                "readOnly": { "type": "boolean" }
              },
              "dependentRequired": {
                "correctOptionId": ["options"]
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "body"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "artifact" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "body": { "type": "string", "minLength": 1 },
                "template": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "variants": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "readOnly": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "items"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "checklist" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "body": { "type": "string" },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/cardBase" },
            {
              "type": "object",
              "required": ["type", "points"],
              "additionalProperties": false,
              "properties": {
                "id": true,
                "type": { "const": "summary" },
                "order": true,
                "title": true,
                "sourceSection": true,
                "thinkingType": true,
                "develops": true,
                "checkability": true,
                "body": { "type": "string" },
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "nextStep": { "type": "string" }
              }
            }
          ]
        }
      ]
    },
    "supplementalItem": {
      "type": "object",
      "required": ["id", "title", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceSection": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supplemental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string"
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trainings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementalItem"
          }
        },
        "spacedRepetition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementalItem"
          }
        },
        "expansionScenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementalItem"
          }
        },
        "editorialRules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "definition"],
            "additionalProperties": false,
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "outcome": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
