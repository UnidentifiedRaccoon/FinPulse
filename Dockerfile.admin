# syntax=docker/dockerfile:1

FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS build
WORKDIR /app
ARG FINPULSE_ADMIN_API_BASE_URL=http://127.0.0.1:3001
ENV FINPULSE_ADMIN_API_BASE_URL=$FINPULSE_ADMIN_API_BASE_URL
COPY . .
RUN npm run build:admin
RUN npm prune --omit=dev

FROM node:24-alpine AS runtime
ARG FINPULSE_ADMIN_API_BASE_URL=http://127.0.0.1:3001
ENV NODE_ENV=production \
    PORT=8080 \
    FINPULSE_ADMIN_API_BASE_URL=$FINPULSE_ADMIN_API_BASE_URL
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/admin ./apps/admin
EXPOSE 8080
CMD ["npm", "run", "start:admin"]
