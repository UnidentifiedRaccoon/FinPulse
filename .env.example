# Use 127.0.0.1 for local development. Production containers should bind FINPULSE_API_HOST=0.0.0.0.
FINPULSE_API_HOST=127.0.0.1
FINPULSE_API_PORT=3001
PORT=3001
FINPULSE_DATABASE_URL=postgres://finpulse:finpulse@127.0.0.1:5432/finpulse
DATABASE_URL=postgres://finpulse:finpulse@127.0.0.1:5432/finpulse
FINPULSE_CORS_ORIGIN=
FINPULSE_COOKIE_SECURE=false
FINPULSE_STATIC_ROOT=

# Internal admin board. Keep real values out of git.
# Generate the bcrypt hash locally, for example:
# node --import tsx -e "import { hashPassword } from './server/lib/password.ts'; console.log(await hashPassword('replace-with-admin-password'))"
FINPULSE_ADMIN_LOGIN=admin@example.com
FINPULSE_ADMIN_PASSWORD_HASH=
FINPULSE_ADMIN_SESSION_SECRET=
FINPULSE_ADMIN_SESSION_MAX_AGE_SECONDS=43200
FINPULSE_ADMIN_API_BASE_URL=http://127.0.0.1:3001
# Production admin UI is a separate container. Set this to the backend production origin at build/deploy time.
# FINPULSE_ADMIN_API_BASE_URL=https://bbabho5nujsp32c8mvc7.containers.yandexcloud.net

# Production can inject either FINPULSE_DATABASE_URL/DATABASE_URL or these pieces.
# Keep FINPULSE_DATABASE_PASSWORD in a secret manager; do not commit real values.
FINPULSE_DATABASE_HOST=
FINPULSE_DATABASE_PORT=6432
FINPULSE_DATABASE_NAME=finpulse
FINPULSE_DATABASE_USER=finpulse_app
FINPULSE_DATABASE_PASSWORD=
FINPULSE_DATABASE_SSLMODE=require
